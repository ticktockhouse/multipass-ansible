alloy_mimir_host: 10.0.0.13
alloy_config: |
  // --- Host-level metrics (equivalent of node_exporter scrape) ---
  prometheus.exporter.unix "system" {}

  prometheus.scrape "host" {
    targets         = prometheus.exporter.unix.system.targets
    scrape_interval = "15s"
    forward_to      = [prometheus.relabel.drop_noisy.receiver]
  }

  // --- cAdvisor / container metrics scrape ---
  prometheus.scrape "cadvisor" {
    targets = [
      {"__address__" = "cadvisor:8080"},
    ]
    metrics_path    = "/metrics"
    scrape_interval = "15s"
    forward_to      = [prometheus.relabel.drop_noisy.receiver]
  }

  // --- Relabeling: fix the high-cardinality rejection you hit yesterday ---
  prometheus.relabel "drop_noisy" {
    forward_to = [prometheus.remote_write.mimir.receiver]

    rule {
      source_labels = ["__name__"]
      regex         = "container_.*"
      action        = "drop"          // or keep, then use label_drop on specific offending labels
    }
  }

  // --- Remote write to Mimir ---
  prometheus.remote_write "mimir" {
    endpoint {
      url = "http://{{ alloy_mimir_host }}:9009/api/v1/push"

      headers = {
        "X-Scope-OrgID" = "anonymous",  // matches Mimir's default single-tenant mode
      }

      queue_config {
        capacity           = 10000
        max_shards         = 10
        batch_send_deadline = "5s"
      }
    }

    wal {
      truncate_frequency = "2h"
      min_keepalive_time  = "5m"
      max_keepalive_time  = "8h"
    }
  }